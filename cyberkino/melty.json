{
  "schemaVersion": 1,
  "mode": "installed",
  "games": [
    {
      "slug": "custom-call-of-duty-black-ops",
      "role": "primary"
    },
    {
      "slug": "cyberpunk-2077",
      "role": "companion"
    }
  ],
  "components": [
    {
      "id": "main",
      "fileName": "CyberKino-0.1.8.zip",
      "label": "Cyberpunk Kino",
      "kind": "main",
      "required": true
    }
  ],
  "requirements": [],
  "mappings": [
    {
      "component": "main",
      "from": "CyberKino/",
      "to": "{managed}"
    }
  ],
  "launch": {
    "kind": "exe",
    "path": "{managed}/cyberkino-launch.exe",
    "args": [
      "--bo",
      "{game}",
      "--cp",
      "{game:cyberpunk-2077}"
    ],
    "cwd": "{managed}"
  },
  "runtimeData": [
    "{localappdata}/CyberKino"
  ]
}
