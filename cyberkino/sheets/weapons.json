{
  "sheet": "weapons",
  "about": "Every gun in Kino. Each Black Ops gun is rebuilt on the player's PC each Play: its weapon file is copied from their own Black Ops (bo_base, dumped from zombie_theater.ff by OpenAssetTools' Unlinker) with Cyberpunk numbers and models swapped in, and its models are the listed Cyberpunk meshes exported from their own Cyberpunk install by WolvenKit, fitted into the bo_base gun's own shape and skeleton so Black Ops' animations carry them. Nothing from either game is shipped. Pack-a-Punch gives the _upgraded copy, built the same way from bo_base_upgraded.",
  "columns": {
    "id": "unique id; Black Ops weapon names are cpk_<id>_zm and cpk_<id>_upgraded_zm",
    "name": "in-game name (the Cyberpunk gun's name)",
    "pap_name": "name after Pack-a-Punch",
    "cp_meshes": "Cyberpunk depot paths of the meshes merged into one model (body, receiver, magazine)",
    "bo_base": "Black Ops weapon whose file, animations, sounds and skeleton the gun uses",
    "bo_base_upgraded": "Black Ops weapon the Pack-a-Punch copy is built from",
    "role": "start (replaces the starting pistol) | wall (replaces wall-buys listed in replaces) | box (Mystery Box) | rare (Mystery Box, a third as likely)",
    "replaces": "stock wall-buy weapon names this gun takes over (empty unless role is start or wall)",
    "cost": "wall-buy price in points (0 for box, rare and start guns)",
    "damage_mult": "multiplier on bo_base's damage and minDamage",
    "clip_size": "rounds per magazine",
    "max_ammo": "reserve rounds",
    "fire_time_mult": "multiplier on bo_base's fireTime (above 1 = slower)",
    "pap_damage_mult": "multiplier on bo_base_upgraded's damage and minDamage",
    "pap_clip_size": "rounds per magazine after Pack-a-Punch",
    "pap_max_ammo": "reserve rounds after Pack-a-Punch",
    "box_weight": "Mystery Box weight (3 normal, 1 rare, 0 not in the box)",
    "vox": "announcer/character voice category Black Ops plays on pickup: pistol | smg | shotgun | assault | sniper | mg | raygun",
    "fit_scale": "size multiplier after fitting the Cyberpunk mesh to bo_base's gun length",
    "source": "where the cells came from",
    "tested_in_game": "true once bought, fired and Pack-a-Punched in Kino"
  },
