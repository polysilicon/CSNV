    "inside_x": "barricade: X of the side V stands on (where a push sends V); others: where V stood",
    "inside_y": "see inside_x",
    "inside_z": "see inside_x",
    "entity": "stash: the stash's EntityID hash as CET prints it (e.g. 123ULL); others: none",
    "source": "where it came from",
    "tested_in_game": "true once played on"
  },
