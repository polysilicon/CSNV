    "id": "unique id (kind_n)",
    "kind": "start | barricade | wallbuy | box | spawn | stash",
    "x": "world X (m)",
    "y": "world Y",
    "z": "world Z",
    "yaw": "facing (degrees)",
    "zone": "barricade: the zone it closes (buying it opens zone+1; each barricade is bought on its own); spawn: the zone it belongs to (active once open); others: not used",
