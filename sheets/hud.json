{
  "sheet": "hud",
  "about": "CS2-style HUD elements. Original art only; nothing from Valve's files.",
  "columns": {
    "id": "unique element id",
    "label": "text or icon shown",
    "anchor": "screen corner",
    "source_hook": "hooks.id the value comes from",
    "format": "how the value is printed",
    "refresh_sec": "how often it updates",
    "art": "original asset file under assets/ (or 'text' for plain text)",
    "verified": "true once seen in the running game"
  },
  "rows": [
    {"id": "hud_health", "label": "+", "anchor": "bottom-left", "source_hook": "player_health", "format": "{value}", "refresh_sec": 0.1, "art": "text", "verified": false},
    {"id": "hud_armor", "label": "shield", "anchor": "bottom-left", "source_hook": "player_armor", "format": "{value}", "refresh_sec": 0.1, "art": null, "verified": false},
    {"id": "hud_ammo", "label": "ammo", "anchor": "bottom-right", "source_hook": "weapon_ammo", "format": "{clip} / {reserve}", "refresh_sec": 0.1, "art": "text", "verified": false},
    {"id": "hud_caps", "label": "caps", "anchor": "bottom-left", "source_hook": "player_caps", "format": "{value} caps", "refresh_sec": 0.5, "art": "text", "verified": false}
  ]
}
